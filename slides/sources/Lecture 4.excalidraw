6.561704217389, "width": 107.75043796505793, "height": 4.918521054350604, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeWidth": 6.652423203371575, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["aLt34-RWUt5GcAAVbBof8"], "frameId": "Z15kAE_EXolKJGZprcAE0", "index": "c00FE", "roundness": {"type": 2}, "seed": 1267424263, "version": 1, "versionNonce": 1833919235, "isDeleted": false, "boundElements": [], "updated": 1757000000000, "link": null, "locked": false, "points": [[0.0, 0.0], [-107.75043796505793, -4.918521054350604]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "triangle", "elbowed": false, "created": null}, {"type": "rectangle", "version": 1, "versionNonce": 1934903862, "isDeleted": false, "id": "47aSdSOxXUqY0elejU9ER", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "x": 6660.0, "y": 10713.761486514097, "strokeColor": "#000000", "backgroundColor": "#ffec99", "width": 420, "height": 200, "seed": 1201435568, "groupIds": [], "index": "c00FF", "frameId": "Z15kAE_EXolKJGZprcAE0", "roundness": {"type": 3}, "boundElements": [], "updated": 1757000000000, "link": null, "locked": false}, {"type": "text", "version": 1, "versionNonce": 298534009, "isDeleted": false, "id": "iyrfDu0js3quiZ7-fsLsr", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "x": 6682.0, "y": 10731.761486514097, "strokeColor": "#000000", "backgroundColor": "transparent", "width": 239.4, "height": 23.75, "seed": 1064994422, "groupIds": [], "index": "c00FG", "frameId": "Z15kAE_EXolKJGZprcAE0", "roundness": null, "boundElements": [], "updated": 1757000000000, "link": null, "locked": false, "fontSize": 19, "fontFamily": 1, "text": "Right column: 1 + 1 is two,", "originalText": "Right column: 1 + 1 is two,", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "baseline": 17}, {"type": "text", "version": 1, "versionNonce": 2064042424, "isDeleted": false, "id": "VTKInIERjvhWmxqE6ZzDE", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "x": 6682.0, "y": 10761.761486514097, "strokeColor": "#000000", "backgroundColor": "transparent", "width": 216.619, "height": 23.75, "seed": 1876510393, "groupIds": [], "index": "c00FH", "frameId": "Z15kAE_EXolKJGZprcAE0", "roundness": null, "boundElements": [], "updated": 1757000000000, "link": null, "locked": false, "fontSize": 19, "fontFamily": 1, "text": "so write 0 and carry 1.", "originalText": "so write 0 and carry 1.", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "baseline": 17}, {"type": "text", "version": 1, "versionNonce": 1424156002, "isDeleted": false, "id": "0AlqelZbVEwWZCrVX8K59", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "x": 6682.0, "y": 10799.761486514097, "strokeColor": "#000000", "backgroundColor": "transparent", "width": 298.186, "height": 23.75, "seed": 1907569916, "groupIds": [], "index": "c00FI", "frameId": "Z15kAE_EXolKJGZprcAE0", "roundness": null, "boundElements": [], "updated": 1757000000000, "link": null, "locked": false, "fontSize": 19, "fontFamily": 1, "text": "Next: 0 + 0 plus the carry = 1.", "originalText": "Next: 0 + 0 plus the carry = 1.", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "baseline": 17}, {"type": "text", "version": 1, "versionNonce": 2090219225, "isDeleted": false, "id": "HdvREs9aCy1qkLnJ64JbL", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "x": 6682.0, "y": 10837.761486514097, "strokeColor": "#000000", "backgroundColor": "transparent", "width": 248.482, "height": 23.75, "seed": 138638581, "groupIds": [], "index": "c00FJ", "frameId": "Z15kAE_EXolKJGZprcAE0", "roundness": null, "boundElements": [], "updated": 1757000000000, "link": null, "locked": false, "fontSize": 19, "fontFamily": 1, "text": "Then 1 + 0 = 1, and finally", "originalText": "Then 1 + 0 = 1, and finally", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "baseline": 17}, {"type": "text", "version": 1, "versionNonce": 274536166, "isDeleted": false, "id": "v4y8As4bnkRf55QT88Atb", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "x": 6682.0, "y": 10867.761486514097, "strokeColor": "#000000", "backgroundColor": "transparent", "width": 234.118, "height": 23.75, "seed": 1659896313, "groupIds": [], "index": "c00FK", "frameId": "Z15kAE_EXolKJGZprcAE0", "roundness": null, "boundElements": [], "updated": 1757000000000, "link": null, "locked": false, "fontSize": 19, "fontFamily": 1, "text": "1 + 1 opens a new column.", "originalText": "1 + 1 opens a new column.", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "baseline": 17}, {"type": "text", "version": 1, "versionNonce": 1898957050, "isDeleted": false, "id": "EWfbCmK9mkjk4EA507acN", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "x": 6100.0, "y": 10989.761486514097, "strokeColor": "#000000", "backgroundColor": "transparent", "width": 714.78, "height": 27.5, "seed": 1712968685, "groupIds": [], "index": "c00FL", "frameId": "Z15kAE_EXolKJGZprcAE0", "roundness": null, "boundElements": [], "updated": 1757000000000, "link": null, "locked": false, "fontSize": 22, "fontFamily": 1, "text": "Thirteen plus nine is 10110: sixteen and four and two, which is 22.", "originalText": "Thirteen plus nine is 10110: sixteen and four and two, which is 22.", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResi