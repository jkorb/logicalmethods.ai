 inputs off is an input where it fails.", "originalText": "Both inputs off is an input where it fails.", "fontSize": 17, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "36Tn6p96LjsW5EPfUbxqw", "type": "text", "x": 3100.0, "y": 20332.146824376785, "width": 543.024, "height": 22.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "Ek78eZve5m7TAGmN7Mtrd", "index": "d00O6", "roundness": null, "seed": 825561950, "version": 1, "versionNonce": 1162927091, "isDeleted": false, "boundElements": [], "updated": 1758585600000, "link": null, "locked": false, "text": "Unsatisfiable on the left: the circuit meets its specification.", "originalText": "Unsatisfiable on the left: the circuit meets its specification.", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "xejLPtyBYSyyYbsMUkSo7", "type": "text", "x": 3100.0, "y": 20358.146824376785, "width": 614.43, "height": 22.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "Ek78eZve5m7TAGmN7Mtrd", "index": "d00O7", "roundness": null, "seed": 1952933814, "version": 1, "versionNonce": 913135860, "isDeleted": false, "boundElements": [], "updated": 1758585600000, "link": null, "locked": false, "text": "Satisfiable on the right: the valuation names an input where it fails.", "originalText": "Satisfiable on the right: the valuation names an input where it fails.", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "B9uMQax1bE34hVL_roFzg", "type": "text", "x": 3100.0, "y": 20404.14