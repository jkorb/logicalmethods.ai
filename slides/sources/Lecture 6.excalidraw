trokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "G3VvHBlKLESUt8nrxBbSu", "index": "d00Bg", "roundness": null, "seed": 2061356569, "version": 1, "versionNonce": 2124797414, "isDeleted": false, "boundElements": [], "updated": 1758585600000, "link": null, "locked": false, "text": "of Horn clauses is satisfiable.", "originalText": "of Horn clauses is satisfiable.", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "o5ulYfuWftZeVwqDaIRz4", "type": "text", "x": 3119.5, "y": 14869.266081119737, "width": 254.863, "height": 28.75, "angle": 0, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "G3VvHBlKLESUt8nrxBbSu", "index": "d00Bh", "roundness": null, "seed": 765950741, "version": 1, "versionNonce": 1680339008, "isDeleted": false, "boundElements": [], "updated": 1758585600000, "link": null, "locked": false, "text": "Start from the facts.", "originalText": "Start from the facts.", "fontSize": 23, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "cAGC3JV_jPJ_AVgSvvN6q", "type": "ellipse", "x": 3099.7, "y": 14878.766081119737, "width": 8.4, "height": 8.4, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#000000", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "G3VvHBlKLESUt8nrxBbSu", "index": "d00Bi", "roundness": {"type": 2}, "seed": 1749443121, "version": 1, "versionNonce": 403613059, "isDeleted": false, "boundElements": [], "updated": 1758585600000, "link": null, "locked": false}, {"id": "zfGmp3zVJ6yasEfWgRNrX", "type": "text", "x": 3119.5, "y": 14917.266081119737, "width": 701.362, "height": 28.75, "angle": 0, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "G3VvHBlKLESUt8nrxBbSu", "index": "d00Bj", "roundness": null, "seed": 333218416, "version": 1, "versionNonce": 2080132845, "isDeleted": false, "boundElements": [], "updated": 1758585600000, "link": null, "locked": false, "text": "Whenever all premises of a rule are known, add its conclusion.", "originalText": "Whenever all premises of a rule are known, add its conclusion.", "fontSize": 23, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "BuB5YoixhL8nUXoJl9krQ", "type": "ellipse", "x": 3099.7, "y": 14926.766081119737, "width": 8.4, "height": 8.4, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#000000", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "G3VvHBlKLESUt8nrxBbSu", "index": "d00Bk", "roundness": {"type": 2}, "seed": 803196070, "version": 1, "versionNonce": 1495969606, "isDeleted": false, "boundElements": [], "updated": 1758585600000, "link": null, "locked": false}, {"id": "vkLQ45ftzb3Aa8ROV3qrW", "type": "text", "x": 3119.5, "y": 14965.266081119737, "width": 596.873, "height": 28.75, "angle": 0, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "G3VvHBlKLESUt8nrxBbSu", "index": "d00Bl", "roundness": null, "seed": 1129190179, "version": 1, "versionNonce": 906760926, "isDeleted": false, "boundElements": [], "updated": 1758585600000, "link": null, "locked": false, "text": "If that makes a constraint’s premises true, derive ", "originalText": "If that makes a constraint’s premises true, derive ", "fontSize": 23, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "line