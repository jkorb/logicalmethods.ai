, "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "0kuDq3eFmCjoV08yN8UYl", "type": "text", "x": 3723.4660000000003, "y": 5724.880743257048, "width": 5.206, "height": 23.75, "angle": 0, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "jJf6rkvWg_uo2_4q0-wjX", "index": "d005M", "roundness": null, "seed": 1596081486, "version": 1, "versionNonce": 974299681, "isDeleted": false, "boundElements": [], "updated": 1758585600000, "link": null, "locked": false, "text": ".", "originalText": ".", "fontSize": 19, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "BKw3BJVXG7OhSrUYuE0Tp", "type": "text", "x": 3100.0, "y": 5772.880743257048, "width": 663.534, "height": 22.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "jJf6rkvWg_uo2_4q0-wjX", "index": "d005N", "roundness": null, "seed": 247835296, "version": 1, "versionNonce": 158210256, "isDeleted": false, "boundElements": [], "updated": 1758585600000, "link": null, "locked": false, "text": "The rule introduces negations, so it has to run before the negation rules.", "originalText": "The rule introduces negations, so it has to run before the negation rules.", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "iFHIzKifFRMgsl1G_ZYFl", "type": "text", "x": 4098.3, "y": 5830.980743257049, "width": 15.6667, "height": 30.599, "angle": 0, "strokeColor": "#000000", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "jJf6rkvWg_uo2_4q0-wjX", "index": "d005O", "ro