": 1.25, "baseline": 23}, {"type": "text", "version": 1, "versionNonce": 787892140, "isDeleted": false, "id": "d01UpyhEFEW1-nJuE94lX", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "x": 4119.5, "y": 16080.642229771145, "strokeColor": "#000000", "backgroundColor": "transparent", "width": 489.6823, "height": 31.7761, "seed": 275684365, "groupIds": [], "index": "c00EP", "frameId": "wWY6BaXixU0pzyISd_CaF", "roundness": null, "boundElements": [], "updated": 1757000000000, "link": null, "locked": false, "fontSize": 25.420874461286935, "fontFamily": 1, "text": "hear that Mr. Sir smokes his pipe here.", "originalText": "hear that Mr. Sir smokes his pipe here.", "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "baseline": 23}, {"id": "xQZICmUiVfQoHbD17b4-w", "type": "ellipse", "x": 4889.157054906084, "y": 16096.142901084937, "width": 9.450516212640322, "height": 8.466087440490272, "angle": 0, "strokeColor": "#000000", "backgroundColor": "#d5d5d5", "fillStyle": "solid", "strokeWidth": 0.4885546736716716, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["1IeDwQrqR9xxfWEaQdgSk", "ey_ghyIhrJ1Kv_F6TbsyL"], "frameId": "wWY6BaXixU0pzyISd_CaF", "index": "c00EQ", "roundness": {"type": 2}, "seed": 933130634, "version": 1, "versionNonce": 724745382, "isDeleted": false, "boundElements": [], "updated": 1757000000000, "link": null, "locked": false, "created": null}, {"id": "DsQz7_Mp9wXK_elypmeUq", "type": "ellipse", "x": 4902.850210807024, "y": 16143.771665257646, "width": 76.33079013362165, "height": 57.67911862253126, "angle": 0, "strokeColor": "#000000", "backgroundColor": "#2f9e44", "fillStyle": "solid", "strokeWidth": 0.4885546736716716, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["1IeDwQrqR9xxfWEaQdgSk", "ey_ghyIhrJ1Kv_F6TbsyL"], "frameId": "wWY6BaXixU0pzyISd_CaF", "index": "c00ER", "roundness": {"type": 2}, "seed": 79428