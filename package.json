{
  "name": "logicalmethods-site-checks",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:test": "node scripts/build.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "check:site": "node scripts/check-site.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "lint:markdown": "markdownlint-cli2",
    "check": "npm run test:unit && npm run build:test && npm run check:content && npm run check:site && npm run check:docs && npm run lint:markdown",
    "test": "npm run check && npm run test:browser",
    "test:browser": "node scripts/playwright.mjs test",
    "test:browser:desktop": "node scripts/playwright.mjs test --project=desktop",
    "serve:test": "node scripts/serve.mjs",
    "clean": "node scripts/clean.mjs",
    "clean:all": "node scripts/clean.mjs --all",
    "lint:prose": "node scripts/prose.mjs",
    "check:external": "npm run build:test && node scripts/external.mjs",
    "setup:prose": "node scripts/install-vale.mjs",
    "test:prose": "node scripts/test-prose.mjs",
    "setup:browsers": "node scripts/playwright.mjs install chromium",
    "slides:setup": "npm ci --prefix tools/slides",
    "slides:render": "node tools/slides/render.mjs",
    "slides:edit": "node tools/slides/editor-server.mjs",
    "slides:test": "node --test tools/slides/editor.test.mjs",
    "slides:preview": "hugo server -D --config hugo.toml,hugo.slides-preview.toml --destination tmp/slides-preview-site --port 1315",
    "slides:test:preview": "node scripts/playwright.mjs test --config tools/slides/preview.config.mjs",
    "slides:test:preservation": "node --test tools/slides/preservation.test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "cheerio": "1.2.0",
    "markdownlint-cli2": "0.23.2",
    "yaml": "2.9.0"
  },
  "dependencies": {
    "html-to-image": "1.11.13"
  }
}
