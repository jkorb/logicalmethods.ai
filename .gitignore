public/
.hugo_build.lock
.DS_Store

# Temporary review and validation artifacts
/tmp/

# Development dependencies and local tool downloads
/node_modules/
/tools/slides/node_modules/

# Desktop build of the patched notation font; the site uses the .woff2
/assets/fonts/ComicShanns/comic-shanns-logic.otf

# Local slide originals and exports with unreviewed third-party images.
# Keep these on disk; publish a reviewed lecture by updating this allowlist.
/slides/archive/
/slides/images/
/slides/sources/*
!/slides/sources/Lecture 1.excalidraw
!/slides/sources/Lecture 2.excalidraw
!/slides/sources/Lecture 3.excalidraw
!/slides/sources/Lecture 4.excalidraw
/slides/unpublished/
/content/slides/*/deck/
!/content/slides/logic-and-ai/deck/
!/content/slides/formal-languages/deck/
!/content/slides/valid-inference/deck/
!/content/slides/boolean/deck/
/slides/local-originals/

# Per-person Obsidian state for the docs/ vault. app.json is committed so every
# contributor's Obsidian writes the same relative Markdown links.
/docs/.obsidian/*
!/docs/.obsidian/app.json
!/docs/.obsidian/README.md
